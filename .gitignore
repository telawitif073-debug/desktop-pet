platform/.pg/
platform/backend/dist/
platform/frontend/dist/
platform/backend/uploads/*
!platform/backend/uploads/sample-agent-config.json
!platform/backend/uploads/sample-pet-asset.txt

# 本地工具链与发布产物（体积大、机器相关，不入库）
android-sdk/
jdk17/
cloudflared.exe
dist-share/*
!dist-share/server.js

# SSH 私钥（阿里云 ECS）
*.pem
# 部署产物与数据备份（含密钥/用户数据，严禁入库）
deploy/*.tar.gz
deploy/*.dump
